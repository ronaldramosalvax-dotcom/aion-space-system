<!-- ESTILOS Y PANTALLA EN PRIMER PLANO OBLIGATORIO -->
<style>
    .modal-registro-mecha {
        position: fixed !important;
        top: 0 !important; left: 0 !important;
        width: 100vw !important; height: 100vh !important;
        background: radial-gradient(circle at center, #1a2238 0%, #0d1117 100%) !important;
        display: none;
        justify-content: center !important; align-items: center !important;
        z-index: 999999 !important; padding: 20px !important;
        box-sizing: border-box !important;
    }
    .contenedor-registro-mecha {
        background-color: #1e222b !important; border: 2px solid #5765f2 !important;
        border-radius: 16px !important; width: 100% !important; max-width: 420px !important;
        padding: 30px 20px !important; text-align: center !important;
        box-shadow: 0 0 30px rgba(87, 101, 242, 0.5) !important; box-sizing: border-box !important;
    }
    .input-mecha-piloto {
        width: 100% !important; border: 2px solid #2f3136 !important; background-color: #202225 !important;
        color: #fff !important; padding: 12px 20px !important; border-radius: 30px !important;
        font-size: 1rem !important; outline: none !important; margin-bottom: 20px !important;
        text-align: center !important; box-sizing: border-box !important;
    }
    .grid-pilotos-mecha {
        display: grid !important; grid-template-columns: repeat(2, 1fr) !important;
        gap: 12px !important; margin-bottom: 25px !important; max-height: 200px !important;
        overflow-y: auto !important; padding: 4px !important;
    }
    .tarjeta-piloto-opcion {
        position: relative !important; background: #2f3136 !important;
        border: 2px solid transparent !important; border-radius: 8px !important;
        overflow: hidden !important; cursor: pointer !important;
        display: flex !important; flex-direction: column !important;
    }
    .tarjeta-piloto-opcion.seleccionada {
        border-color: #00f2fe !important; box-shadow: 0 0 12px #00f2fe !important;
    }
    .tarjeta-piloto-opcion img {
        width: 100% !important; height: auto !important; display: block !important; background: #120c1f !important;
    }
    .tag-nombre-avatar {
        position: absolute !important; bottom: 0 !important; width: 100% !important;
        background: rgba(0, 0, 0, 0.8) !important; color: #fff !important;
        font-size: 10px !important; font-weight: bold !important; padding: 4px 0 !important; text-align: center !important;
    }
    .btn-desplegar-piloto {
        background-color: #5765f2 !important; color: #fff !important; border: none !important;
        width: 100% !important; padding: 14px !important; border-radius: 30px !important;
        font-weight: 700 !important; font-size: 1rem !important; cursor: pointer !important;
    }
</style>

<!-- FORMULARIO DE INGRESO DE PILOTOS -->
<div id="pantalla-registro-mecha" class="modal-registro-mecha">
  <div class="contenedor-registro-mecha">
    <h2 style="color: white; margin-bottom: 5px; font-family: sans-serif;">CREACIÓN DE PILOTO</h2>
    <p style="color: #72767d; font-size: 0.85rem; margin-bottom: 20px; font-family: sans-serif;">Crea tu cuenta para iniciar operaciones</p>
    
    <input type="text" id="input-nickname-mecha" class="input-mecha-piloto" placeholder="Introduce tu Nickname..." maxlength="12">

    <h3 style="color: #b9bbbe; font-size: 0.85rem; margin-bottom: 12px; font-family: sans-serif; text-transform: uppercase;">Selecciona tu Avatar</h3>
    
    <div class="grid-pilotos-mecha">
      <!-- Piloto 1: BARON -->
      <div class="tarjeta-piloto-opcion" onclick="seleccionarAvatarMecha(this, 'Baron.png', 'BARON')">
        <img src="Baron.png">
        <div class="tag-nombre-avatar">BARON</div>
      </div>
      <!-- Piloto 2: TANKER -->
      <div class="tarjeta-piloto-opcion" onclick="seleccionarAvatarMecha(this, 'Tanker.png', 'TANKER')">
        <img src="Tanker.png">
        <div class="tag-nombre-avatar">TANKER</div>
      </div>
      <!-- Piloto 3: NEYMAR JR -->
      <div class="tarjeta-piloto-opcion" onclick="seleccionarAvatarMecha(this, 'NeymarJr.png', 'NEYMAR JR.')">
        <img src="NeymarJr.png">
        <div class="tag-nombre-avatar">NEYMAR JR.</div>
      </div>
      <!-- Piloto 4: NOVA -->
      <div class="tarjeta-piloto-opcion" onclick="seleccionarAvatarMecha(this, 'Nova.png', 'NOVA')">
        <img src="Nova.png">
        <div class="tag-nombre-avatar">NOVA</div>
      </div>
    </div>
  </div>
</div>
